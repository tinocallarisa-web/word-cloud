{
  "dataRoles": [
    {
      "name": "words",
      "kind": "Grouping",
      "displayName": "Words",
      "displayNameKey": "Role_words",
      "description": "One word or phrase per row."
    },
    {
      "name": "text",
      "kind": "Grouping",
      "displayName": "Text (free text)",
      "displayNameKey": "Role_text",
      "description": "Comments, answers or reviews. The visual splits them into words and removes stopwords."
    },
    {
      "name": "size",
      "kind": "Measure",
      "displayName": "Size",
      "displayNameKey": "Role_size",
      "description": "Word size. Without it, the number of times the word appears."
    },
    {
      "name": "colorBy",
      "kind": "Measure",
      "displayName": "Color by",
      "displayNameKey": "Role_colorBy",
      "description": "Colour words on a gradient by this measure."
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltips",
      "displayNameKey": "Role_tooltips"
    },
    {
      "name": "maskImage",
      "kind": "Measure",
      "displayName": "Shape image",
      "displayNameKey": "Role_maskImage",
      "description": "A Base64 image (data:image/...) from your model. Words fill its dark area. Set Layout > Shape to Image."
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "words": {
            "max": 1
          },
          "text": {
            "max": 0
          },
          "size": {
            "max": 1
          },
          "colorBy": {
            "max": 1
          },
          "maskImage": {
            "max": 1
          }
        },
        {
          "words": {
            "max": 0
          },
          "text": {
            "max": 1
          },
          "size": {
            "max": 1
          },
          "colorBy": {
            "max": 1
          },
          "maskImage": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "bind": {
                "to": "words"
              }
            },
            {
              "bind": {
                "to": "text"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "size"
              }
            },
            {
              "bind": {
                "to": "colorBy"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            },
            {
              "bind": {
                "to": "maskImage"
              }
            }
          ]
        }
      }
    }
  ],
